APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

TELESCOPE_ENABLED=

# ---------------------------------------------------------------------------
# Rominas
# Commented-out lines show the default the config falls back to.
# ---------------------------------------------------------------------------

# Base URLs of the admin, academy and public-voting SPAs: the targets of e-mailed links.
FRONTEND_ADMIN_URL=http://localhost:3000
FRONTEND_ACADEMY_URL=http://localhost:3001
FRONTEND_VOTING_URL=http://localhost:3002

# Comma-separated proxy IPs/CIDRs to trust for X-Forwarded-For (config/trustedproxy.php).
# The voting frontend proxies through its Next server; trust it so ip_hash is the voter's IP.
# Empty = no proxy is trusted.
TRUSTED_PROXIES=

# Secrets keying the stored hashes of personal data (config/voting.php, config/audit.php). Unset, both
# fall back to APP_KEY; set dedicated values in production, and do not leave them empty: an empty value
# replaces the fallback. Never rotate VOTING_PEPPER once ballots exist: every stored voter hash would
# stop matching.
# VOTING_PEPPER=
# AUDIT_PEPPER=

# E-mail transport (config/delivery.php): smtp = the MAIL_* server above, brevo = Brevo's HTTP API.
# Both send as MAIL_FROM_*. BREVO_TIMEOUT is in seconds.
MAIL_DELIVERY_TRANSPORT=smtp
BREVO_API_KEY=
# BREVO_TIMEOUT=10

# Magic-link lifetimes in minutes (config/magic-link.php): sign-in links and invitations (48 h).
# The e-mail texts state these lifetimes; update them when a value changes.
# MAGIC_LINK_TTL_MINUTES=15
# MAGIC_LINK_INVITATION_TTL_MINUTES=2880

# ZeroBounce validates the address on every public voting-link request (config/services.php).
# Empty key = validation off. The default base URL is the EU endpoint; the timeout is in seconds.
ZEROBOUNCE_API_KEY=
# ZEROBOUNCE_BASE_URL=https://api-eu.zerobounce.net/v2
# ZEROBOUNCE_TIMEOUT=8
# Minutes a rejected address (its hash) is remembered, so a retry costs no ZeroBounce credit.
# VOTING_EMAIL_REJECTION_CACHE_MINUTES=60

# Fraud detection thresholds (config/fraud.php): ballots sharing one IP; submissions inside one
# window; ballots with an identical ranking set.
# FRAUD_SHARED_IP_THRESHOLD=5
# FRAUD_VELOCITY_WINDOW_MINUTES=10
# FRAUD_VELOCITY_THRESHOLD=50
# FRAUD_IDENTICAL_RANKING_THRESHOLD=3

# Results algorithm (config/scoring.php): attributed (the client's formula) or share.
# SCORING_ALGORITHM=attributed

# Daily log files kept per channel (a count, not days) and days a failed job is kept.
# LOG_MAX_FILES=14

# Rarely changed: the role that bypasses every permission check (config/permission.php) and the
# academy member model (config/auth.php).
# SUPER_ADMIN_ROLE=super_admin
# AUTH_MEMBER_MODEL="Rominas\Academy\Member\Model\Member"
